# Block all direct web access to this directory. PHP error logs are
# written here (see ../error-log-config.php) and must never be
# downloadable - they can contain file paths, query strings, and other
# request details that shouldn't be public.
#
# Covers both Apache 2.4+ (Require) and 2.2 (Order/Deny) syntax so this
# works regardless of which the production host is running.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
