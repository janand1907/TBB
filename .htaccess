RewriteEngine On

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.tirupatibalajibooking\.com$ [NC]
RewriteRule ^(.*)$ https://www.tirupatibalajibooking.com/$1 [L,R=301]

Redirect 301 /tirupati-300-darshan-package-from-chennai.php /srivani-vip-break-darshan-from-chennai.php

