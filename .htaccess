RewriteEngine On

# Preferred canonical URLs for the homepage and explicitly routed VIP package pages.
# These run before the host/HTTPS redirect to avoid redirect chains, and only
# for direct browser requests so they do not interfere with internal rewrites.
RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
RewriteRule ^index\.php$ https://www.divinebalajitravels.com/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+tirupati-vip-darshan-packages\.php[?\s] [NC]
RewriteRule ^tirupati-vip-darshan-packages\.php$ https://www.divinebalajitravels.com/tirupati-vip-darshan-packages [R=301,L]
RewriteCond %{THE_REQUEST} \s/+hyderabad-tirupati-flight-package-two-days\.php[?\s] [NC]
RewriteRule ^hyderabad-tirupati-flight-package-two-days\.php$ https://www.divinebalajitravels.com/hyderabad-tirupati-flight-package-two-days [R=301,L]
RewriteCond %{THE_REQUEST} \s/+mumbai-tirupati-flight-package-two-days\.php[?\s] [NC]
RewriteRule ^mumbai-tirupati-flight-package-two-days\.php$ https://www.divinebalajitravels.com/mumbai-tirupati-flight-package-two-days [R=301,L]
RewriteCond %{THE_REQUEST} \s/+bengaluru-tirupati-flight-package-two-days\.php[?\s] [NC]
RewriteRule ^bengaluru-tirupati-flight-package-two-days\.php$ https://www.divinebalajitravels.com/bengaluru-tirupati-flight-package-two-days [R=301,L]
RewriteCond %{THE_REQUEST} \s/+delhi-tirupati-flight-package-two-days\.php[?\s] [NC]
RewriteRule ^delhi-tirupati-flight-package-two-days\.php$ https://www.divinebalajitravels.com/delhi-tirupati-flight-package-two-days [R=301,L]

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.divinebalajitravels\.com$ [NC]
RewriteRule ^(.*)$ https://www.divinebalajitravels.com/$1 [L,R=301]

Redirect 301 /tirupati-300-darshan-package-from-chennai.php /srivani-vip-break-darshan-from-chennai.php
Redirect 301 /blog/tirupati-travel-guide-for-nri-and-overseas-devotees /tirupati-travel-guide-nri-overseas-devotees

# Public blog routes. Categories keep their /blog/{category}/ URLs. Legacy
# article URLs are resolved by PHP so only real posts redirect to their new
# root-level canonical URLs; category archives continue to work normally.
# Category-wise XML sitemaps. sitemap.xml is the canonical sitemap index;
# child URLs are internal rewrites, so crawlers always see their public XML URL.
RewriteRule ^sitemap\.xml$ sitemap.php?sitemap=index [L,QSA]
RewriteRule ^pages-sitemap\.xml$ sitemap.php?sitemap=pages [L,QSA]
RewriteRule ^packages-sitemap\.xml$ sitemap.php?sitemap=packages [L,QSA]
RewriteRule ^blog-sitemap\.xml$ sitemap.php?sitemap=blog [L,QSA]
RewriteRule ^categories-sitemap\.xml$ sitemap.php?sitemap=categories [L,QSA]
RewriteRule ^blog/?$ blog.php [L,QSA]
RewriteRule ^blog/([A-Za-z0-9][A-Za-z0-9-]*)/?$ blog.php?slug=$1&legacy_blog_article=1 [L,QSA,NC]

# Public package landing pages: explicit extensionless routes only.
RewriteRule ^tirupati-vip-darshan-packages/?$ tirupati-vip-darshan-packages.php [L,QSA]
RewriteRule ^hyderabad-tirupati-flight-package-two-days/?$ hyderabad-tirupati-flight-package-two-days.php [L,QSA]
RewriteRule ^mumbai-tirupati-flight-package-two-days/?$ mumbai-tirupati-flight-package-two-days.php [L,QSA]
RewriteRule ^bengaluru-tirupati-flight-package-two-days/?$ bengaluru-tirupati-flight-package-two-days.php [L,QSA]
RewriteRule ^delhi-tirupati-flight-package-two-days/?$ delhi-tirupati-flight-package-two-days.php [L,QSA]

# Root-level blog article fallback. It runs after explicit public routes and
# refuses to claim real files, directories, or an existing public PHP/HTML
# page. This keeps package, service, and static pages ahead of blog slugs.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html !-f
RewriteCond %{DOCUMENT_ROOT}/$1.htm !-f
RewriteRule ^([A-Za-z0-9][A-Za-z0-9-]*)/?$ blog.php?slug=$1&root_blog_article=1 [L,QSA,NC]

# # Remove .html extension from URL
# RewriteCond %{THE_REQUEST} \s/([^.]+)\.html [NC]
# RewriteRule ^ /%1 [R=301,L]

# # Remove .php extension from URL
# RewriteCond %{THE_REQUEST} \s/([^.]+)\.php [NC]
# RewriteRule ^ /%1 [R=301,L]

# # Internally load .html file
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteCond %{REQUEST_FILENAME}.html -f
# RewriteRule ^([^\.]+)$ $1.html [L]

# # Internally load .php file
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteCond %{REQUEST_FILENAME}.php -f
# RewriteRule ^([^\.]+)$ $1.php [L]

# Performance: compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2 application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
  AddOutputFilterByType BROTLI_COMPRESS font/ttf font/otf font/woff font/woff2
</IfModule>

# Performance: browser caching / expires headers
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(ttf|otf|woff|woff2|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
